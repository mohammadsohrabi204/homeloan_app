# ============================================================
#  نمونهٔ فایل تنظیمات محیطی
#  این فایل را به نام .env کپی کنید و مقادیر را پر کنید:
#      cp .env.example .env
#  هشدار: فایل .env را هرگز در گیت/گیت‌هاب قرار ندهید.
# ============================================================

# --- کلید امنیتی (اجباری) -----------------------------------
# یک مقدار تصادفی و طولانی بسازید:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=here-put-a-long-random-value

# --- حالت توسعه/تولید ---------------------------------------
# روی سرور واقعی حتماً false باشد. اگر true بماند، جزئیات خطاها
# (شامل بخشی از تنظیمات) به کاربر نشان داده می‌شود.
DJANGO_DEBUG=true

# دامنه‌هایی که برنامه اجازهٔ پاسخ‌دهی روی آن‌ها را دارد (با کاما جدا کنید)
ALLOWED_HOSTS=127.0.0.1,localhost

# روی سرور واقعی با HTTPS، دامنه‌ها را اینجا هم بنویسید:
# CSRF_TRUSTED_ORIGINS=https://vam.example.com

# --- دیتابیس ------------------------------------------------
# اگر خالی بماند از SQLite استفاده می‌شود (فقط برای توسعهٔ محلی).
# برای سرور واقعی حتماً PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/homeloan

# --- درگاه پرداخت -------------------------------------------
# manual   = بدون درگاه؛ کاربر واریز می‌کند و مدیر در پنل تأیید می‌کند
# zarinpal = درگاه آنلاین زرین‌پال
PAYMENT_GATEWAY=manual

ZARINPAL_MERCHANT_ID=
# تا وقتی تست می‌کنید true بماند؛ برای پول واقعی false کنید.
ZARINPAL_SANDBOX=true

# --- HTTPS ---------------------------------------------------
# اگر پشت nginx/کلادفلر با SSL هستید true بگذارید.
SECURE_SSL_REDIRECT=true

# --- تأیید شماره موبایل با پیامک -------------------------------------
# console فقط برای توسعه است و کد را در خروجی سرور ثبت می‌کند.
# در سرور واقعی kavenegar را انتخاب کرده و کلید سرویس پیامکی خود را وارد کنید.
SMS_BACKEND=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
PHONE_OTP_TTL_MINUTES=5
